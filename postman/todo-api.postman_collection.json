  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"returns healthy status\", function () {",
                  "    pm.expect(pm.response.json()).to.eql({ status: \"ok\" });",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Health Check - success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"status\": \"ok\"\n}",
              "originalRequest": {
                "auth": {
                  "type": "noauth"
                },
                "method": "GET",
                "url": "{{baseUrl}}/api/health"
              }
            }
          ]
        }
      ]
    },
